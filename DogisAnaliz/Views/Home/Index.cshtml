@model DogisAnaliz.Models.DashboardViewModel
@{
    ViewData["Title"] = "DogisAnaliz - Dashboard";
    var nextWeekSort = Model.SortOrder == "week_asc" ? "week_desc" : "week_asc";
    var nextDateSort = Model.SortOrder == "date_desc" ? "date_asc"  : "date_desc";
    var view = Model.ViewMode;
    var fixturesMode = view == "fixtures";
    var standingsMode = view == "standings";
}

<style>
    body {
        background-color: #0b1120;
        color: #f8fafc;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .sidebar {
        background-color: #1e293b;
        border-radius: 12px;
        min-height: 85vh;
        padding: 1.25rem;
        border: 1px solid #334155;
    }

    .nav-league-item {
        color: #cbd5e1;
        padding: 10px 14px;
        border-radius: 8px;
        text-decoration: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
        transition: all 0.2s;
        font-size: 0.95rem;
    }

        .nav-league-item:hover {
            background-color: #334155;
            color: #ffffff;
        }

        .nav-league-item.active {
            background-color: #2563eb;
            color: #ffffff;
            font-weight: bold;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.3);
        }

    .sidebar-group summary {
        cursor: pointer;
        color: #94a3b8;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 10px 6px;
        list-style: none;
        display: flex;
        align-items: center;
        gap: 6px;
    }
        .sidebar-group summary::-webkit-details-marker { display: none; }
        .sidebar-group summary::before {
            content: "";
            display: inline-block;
            width: 0; height: 0;
            border-top: 4px solid transparent;
            border-bottom: 4px solid transparent;
            border-left: 5px solid #64748b;
            transition: transform 0.15s;
        }
        .sidebar-group[open] > summary::before { transform: rotate(90deg); }
        .sidebar-group:not(:first-of-type) { border-top: 1px solid #334155; margin-top: 8px; padding-top: 2px; }

    /* Seçili ligin özet satırı — <summary> içinde, tıklanabilir görünüm korunur */
    .league-summary-row {
        color: #f8fafc;
        padding: 10px 14px;
        border-radius: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex: 1 1 auto;
        min-width: 0;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        font-weight: 700;
        font-size: 0.95rem;
        box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.3);
    }
    .league-summary-row > span:first-child {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
    }
    .league-summary-row .badge { background: rgba(0,0,0,0.25) !important; flex-shrink: 0; }

    /* Takım listesi — nowrap ŞART: Bootstrap'ın .nav.flex-column'ı hâlâ flex-wrap:wrap
       bırakır, max-height ile birleşince taşan takımlar yan yana YENİ SÜTUNA geçer.
       nowrap ile garantili tek sütun + dikey scroll. */
    .team-list {
        flex-wrap: nowrap !important;
        max-height: 360px;
        overflow-y: auto;
        overflow-x: hidden;
        margin: 6px 0 4px 10px;
        padding-left: 12px;
        border-left: 2px solid #334155;
    }
    .nav-team-item {
        color: #94a3b8;
        padding: 8px 12px;
        border-radius: 7px;
        text-decoration: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 2px;
        font-size: 0.87rem;
        transition: background-color 0.15s, color 0.15s, transform 0.1s;
        width: 100%;
    }
        .nav-team-item:hover { background-color: #334155; color: #f1f5f9; transform: translateX(2px); }
        .nav-team-item.active {
            background-color: rgba(37, 99, 235, 0.18);
            color: #93c5fd;
            font-weight: 700;
            box-shadow: inset 2px 0 0 #3b82f6;
        }
        .nav-team-item .small { opacity: 0.7; font-variant-numeric: tabular-nums; }

    .kpi-card {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 1.2rem;
    }

    .kpi-title {
        font-size: 0.85rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
    }

    .kpi-value {
        font-size: 1.9rem;
        font-weight: bold;
        margin-top: 4px;
    }

    .table-container {
        background-color: #1e293b;
        border-radius: 12px;
        padding: 1.25rem;
        border: 1px solid #334155;
    }

    .table-dark-custom {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 6px;
    }

        .table-dark-custom th {
            color: #cbd5e1;
            font-weight: 700;
            padding: 12px 14px;
            border-bottom: 2px solid #334155;
            text-align: left;
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .table-dark-custom td {
            background-color: #0f172a;
            padding: 14px;
            vertical-align: middle;
            border-top: 1px solid #1e293b;
            border-bottom: 1px solid #1e293b;
        }

        .table-dark-custom tr td:first-child {
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
            border-left: 1px solid #1e293b;
        }

        .table-dark-custom tr td:last-child {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
            border-right: 1px solid #1e293b;
        }

    /* Canlı ve Net Okunan Renkler */
    .cell-date {
        color: #f1f5f9 !important;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .cell-ht {
        color: #38bdf8 !important;
        font-weight: 700;
        font-size: 1rem;
    }

    .cell-ft {
        color: #ffffff !important;
        font-weight: 800;
        font-size: 1.05rem;
    }

    .cell-code {
        color: #fbbf24 !important;
        font-weight: 800;
        font-size: 1.05rem;
    }

    .cell-goals {
        color: #a78bfa !important;
        font-weight: 700;
        font-size: 1rem;
    }

    /* Rozetler */
    .badge-double {
        background-color: #7c3aed;
        color: #ffffff;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        display: inline-block;
    }

    .badge-turnaround {
        background-color: #ea580c;
        color: #ffffff;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        display: inline-block;
    }

    .badge-upcoming {
        background-color: #334155;
        color: #cbd5e1;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        display: inline-block;
    }
    .row-upcoming td { opacity: 0.72; }
    .row-upcoming .col-mac span { color: #94a3b8 !important; }

    .badge-highgoal {
        background-color: #0284c7;
        color: #ffffff;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        display: inline-block;
    }

    /* Filtre Butonları */
    .btn-filter {
        background-color: #1e293b;
        border: 1px solid #334155;
        color: #cbd5e1;
        border-radius: 8px;
        padding: 7px 16px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-filter:hover {
            background-color: #334155;
            color: #ffffff;
        }

        .btn-filter.active {
            background-color: #2563eb;
            color: #ffffff;
            border-color: #2563eb;
        }

    /* Ana sekmeler: Sürpriz / Fikstür — küçük hızlı-filtre butonlarından bilerek ayrı ve
       belirgin: daha büyük, aralarında boşluk, aktifte dolgu renk + alt çizgi vurgusu. */
    .main-tabs {
        display: flex;
        gap: 16px;
        margin-bottom: 1.25rem;
    }
    .main-tab {
        background-color: #131c31;
        border: 1px solid #334155;
        color: #94a3b8;
        border-radius: 12px;
        padding: 14px 28px;
        text-decoration: none;
        font-size: 1.1rem;
        font-weight: 700;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 10px;
    }
        .main-tab:hover {
            border-color: #475569;
            color: #f1f5f9;
            transform: translateY(-1px);
        }
        .main-tab.active {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            border-color: #3b82f6;
            color: #ffffff;
            box-shadow: 0 8px 16px -4px rgba(37, 99, 235, 0.45);
        }
        .main-tab .tab-icon { font-size: 1.3rem; }

    .season-select {
        background-color: #0f172a;
        color: #f8fafc;
        border: 1px solid #475569;
        border-radius: 8px;
        padding: 6px 12px;
        font-weight: 600;
        font-size: 0.9rem;
    }

        .season-select:focus {
            border-color: #3b82f6;
            outline: none;
        }

    .sort-header {
        color: #f8fafc;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .sort-header:hover {
            color: #38bdf8;
        }

    /* Sütun genişlikleri - kayma önleme */
    .col-hafta   { width: 80px;  white-space: nowrap; }
    .col-tarih   { width: 110px; white-space: nowrap; }
    .col-mac     { min-width: 200px; }
    .col-iy      { width: 70px;  white-space: nowrap; text-align: center; }
    .col-ms      { width: 70px;  white-space: nowrap; text-align: center; }
    .col-sonuc   { width: 80px;  white-space: nowrap; text-align: center; }
    .col-gol     { width: 90px;  white-space: nowrap; text-align: center; }
    .col-durum   { width: 160px; white-space: nowrap; text-align: center; }
</style>

<div class="container-fluid mt-3 mb-5">
    <div class="row">
        <!-- SOL PANEL (SIDEBAR) -->
        <div class="col-md-5 col-lg-4 col-xl-3 mb-3">
            <div class="sidebar shadow-sm">
                <h5 class="fw-bold mb-2 text-white d-flex align-items-center gap-2">
                    <span>🏆</span> Ligler
                </h5>

                @{
                    var big5 = Model.Leagues.Where(l => l.Tier == 0).ToList();
                    var others = Model.Leagues.Where(l => l.Tier == 1).ToList();
                    var secondTier = Model.Leagues.Where(l => l.Tier == 2).ToList();
                }

                <details class="sidebar-group" open>
                    <summary>Büyük 5</summary>
                    <div class="nav flex-column">
                        @foreach (var league in big5)
                        {
                            <partial name="_LeagueSidebarItem" model="@((league, Model))" />
                        }
                    </div>
                </details>

                @if (others.Any())
                {
                    <details class="sidebar-group" open>
                        <summary>Diğer Ligler</summary>
                        <div class="nav flex-column">
                            @foreach (var league in others)
                            {
                                <partial name="_LeagueSidebarItem" model="@((league, Model))" />
                            }
                        </div>
                    </details>
                }

                @if (secondTier.Any())
                {
                    <details class="sidebar-group" open="@(secondTier.Any(l => l.Id == Model.SelectedLeagueId) ? "open" : null)">
                        <summary>2. Ligler</summary>
                        <div class="nav flex-column">
                            @foreach (var league in secondTier)
                            {
                                <partial name="_LeagueSidebarItem" model="@((league, Model))" />
                            }
                        </div>
                    </details>
                }
            </div>
        </div>

        <!-- SAĞ PANEL (ANA ÇALIŞMA ALANI) -->
        <div class="col-md-7 col-lg-8 col-xl-9">
            @if (TempData["SyncResult"] != null)
            {
                <div class="alert @(TempData["SyncResult"]!.ToString()!.StartsWith("✅") ? "alert-success" : "alert-danger") py-2 mb-3" style="font-size:0.9rem;">
                    @TempData["SyncResult"]
                </div>
            }

            <!-- TEK DÜĞME: TÜM LİGLERİN AKTİF SEZON MAÇLARINI GÜNCELLE -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 p-3 rounded-3 border border-primary border-opacity-25"
                 style="background:#111c30;">
                <div>
                    <span class="fw-bold text-white">🔄 Senkronize Et</span>
                    <span class="text-secondary small ms-2">
                        Tek tıkla <strong>tüm liglerin</strong> aktif sezon (@(DogisAnaliz.Services.LeagueCatalog.ActiveSeasonYear)-@(DogisAnaliz.Services.LeagueCatalog.ActiveSeasonYear + 1)) maçlarını api-sports'tan çeker.
                    </span>
                </div>
                <form method="post" action="/Sync/RefreshAllActive"
                      onsubmit="var b=this.querySelector('button'); b.disabled=true; b.textContent='⏳ Güncelleniyor…';">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                    <button type="submit" class="btn btn-primary btn-sm fw-semibold"
                            title="Tüm liglerin aktif sezonundaki oynanan maçları api-sports'tan günceller (~15-30 sn)"
                            onclick="return confirm('Tüm liglerin aktif sezonu (@(DogisAnaliz.Services.LeagueCatalog.ActiveSeasonYear)-@(DogisAnaliz.Services.LeagueCatalog.ActiveSeasonYear + 1)) maçları güncellenecek. 15-30 saniye sürebilir. Devam edilsin mi?');">
                        🔄 Şimdi Senkronize Et
                    </button>
                </form>
            </div>

            @if (!standingsMode)
            {
            <!-- ÜST BAŞLIK VE YIL / SEZON FİLTRESİ -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-dark p-3 rounded-3 border border-secondary border-opacity-25 shadow-sm">
                <div>
                    @if (fixturesMode)
                    {
                        <h3 class="fw-bold text-white mb-0">@LeagueDisplayHelper.ToTurkish(Model.SelectedLeagueName) Fikstür &amp; Sonuçlar</h3>
                        <small class="text-secondary">Oynanan maçlar + sezonun kalan fikstürü — hafta, İY/MS skoru ve rakip</small>
                    }
                    else
                    {
                        <h3 class="fw-bold text-white mb-0">@LeagueDisplayHelper.ToTurkish(Model.SelectedLeagueName) Sürpriz Analizi</h3>
                        <small class="text-secondary">Sadece 1/2, 2/1 ve +6 Gol Biten Özel Karşılaşmalar</small>
                    }
                </div>

                <!-- YIL / SEZON DROPDOWN FİLTRESİ -->
                <div class="d-flex align-items-center gap-2 mt-2 mt-sm-0 flex-wrap">
                    <label class="text-light fw-semibold small">Sezon:</label>
                    <select class="season-select" onchange="location = this.value;">
                        @foreach (var season in Model.Seasons)
                        {
                            var isSelected = season.Id == Model.SelectedSeasonId ? "selected" : "";
                            <!option value="@Url.Action("Index", new { leagueId = Model.SelectedLeagueId, seasonId = season.Id, teamId = Model.SelectedTeamId, filter = Model.SelectedFilter, sort = Model.SortOrder, view })" @isSelected>
                                @season.SeasonName
                            </!option>
                        }
                    </select>

                    @if (Model.Teams.Any())
                    {
                        <label class="text-light fw-semibold small ms-2">Takım:</label>
                        <div style="position:relative; display:inline-block;">
                            <!-- Yazarak arama kutusu -->
                            <input type="text" id="teamSearchInput" class="season-select"
                                   placeholder="Takım ara..." autocomplete="off"
                                   style="min-width:180px;"
                                   value="@(Model.SelectedTeamId.HasValue ? Model.Teams.FirstOrDefault(t => t.Id == Model.SelectedTeamId)?.Name : "")"
                                   oninput="filterTeamDropdown()" onkeydown="handleTeamKey(event)" />
                            <!-- Dropdown seçimi (normalde gizli, arama ile filtrelenir) -->
                            <select id="teamSelect" class="season-select" onchange="location = this.value;"
                                    style="min-width:180px; display:none;">
                                <option value="@Url.Action("Index", new { leagueId = Model.SelectedLeagueId, seasonId = Model.SelectedSeasonId, teamId = (int?)null, filter = Model.SelectedFilter, sort = Model.SortOrder, view })">
                                    — Tüm Takımlar —
                                </option>
                                @foreach (var team in Model.Teams)
                                {
                                    var isSel = team.Id == Model.SelectedTeamId;
                                    if (isSel)
                                    {
                                        <option value="@Url.Action("Index", new { leagueId = Model.SelectedLeagueId, seasonId = Model.SelectedSeasonId, teamId = team.Id, filter = Model.SelectedFilter, sort = Model.SortOrder, view })" selected
                                                data-name="@team.Name">
                                            @team.Name (@(fixturesMode ? team.MatchCount : team.SurpriseCount))
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@Url.Action("Index", new { leagueId = Model.SelectedLeagueId, seasonId = Model.SelectedSeasonId, teamId = team.Id, filter = Model.SelectedFilter, sort = Model.SortOrder, view })"
                                                data-name="@team.Name">
                                            @team.Name (@(fixturesMode ? team.MatchCount : team.SurpriseCount))
                                        </option>
                                    }
                                }
                            </select>
                            <!-- Öneri listesi -->
                            <div id="teamSuggestions" style="
                                display:none; position:absolute; top:100%; left:0; right:0;
                                background:#1e293b; border:1px solid #475569; border-radius:8px;
                                max-height:220px; overflow-y:auto; z-index:1000; min-width:220px;">
                            </div>
                        </div>
                        @if (Model.SelectedTeamId.HasValue)
                        {
                            <a href="@Url.Action("Index", new { leagueId = Model.SelectedLeagueId, seasonId = Model.SelectedSeasonId, filter = Model.SelectedFilter, sort = Model.SortOrder, view })"
                               class="btn-filter" style="padding:5px 10px; font-size:0.8rem;" title="Takım filtresini kaldır">✕</a>
                        }
                    }
                </div>
            </div>
            }

            <!-- SÜRPRİZ / FİKSTÜR SEKMELERİ -->
            <div class="main-tabs">
                <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="ALL" asp-route-sort="@Model.SortOrder" asp-route-view="surprise" class="main-tab @(!fixturesMode && !standingsMode ? "active" : "")">
                    <span class="tab-icon">🎯</span> Sürpriz
                </a>
                <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="ALL" asp-route-sort="@Model.SortOrder" asp-route-view="fixtures" class="main-tab @(fixturesMode ? "active" : "")">
                    <span class="tab-icon">📋</span> Fikstür
                </a>
                <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="ALL" asp-route-sort="@Model.SortOrder" asp-route-view="standings" class="main-tab @(standingsMode ? "active" : "")">
                    <span class="tab-icon">🏆</span> Puan Durumu
                </a>
            </div>

            @if (standingsMode)
            {
                <partial name="_StandingsTable" model="Model" />
            }
            else
            {
            <!-- KPI ÖZET KARTLARI -->
            <div class="row g-3 mb-4">
                @if (fixturesMode)
                {
                    <div class="col-6 col-md-3 col-lg">
                        <div class="kpi-card shadow-sm border-secondary">
                            <div class="kpi-title text-light">Oynanan Maç</div>
                            <div class="kpi-value text-white">@Model.TotalMatchesCount</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-lg">
                        <div class="kpi-card shadow-sm border-success border-opacity-50">
                            <div class="kpi-title text-success">Ev Galibiyeti</div>
                            <div class="kpi-value text-success">@Model.HomeWinCount</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-lg">
                        <div class="kpi-card shadow-sm border-secondary border-opacity-50">
                            <div class="kpi-title text-light">Beraberlik</div>
                            <div class="kpi-value text-white">@Model.DrawCount</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-lg">
                        <div class="kpi-card shadow-sm border-primary border-opacity-50">
                            <div class="kpi-title text-primary">Deplasman Galibiyeti</div>
                            <div class="kpi-value text-primary">@Model.AwayWinCount</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-lg">
                        <div class="kpi-card shadow-sm border-info border-opacity-50">
                            <div class="kpi-title text-info">Gol Ortalaması</div>
                            <div class="kpi-value text-info">@Model.AvgGoals.ToString("0.00")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-lg">
                        <div class="kpi-card shadow-sm" style="border-color:#a78bfa;">
                            <div class="kpi-title" style="color:#a78bfa;">🔮 Kalan Fikstür</div>
                            <div class="kpi-value" style="color:#c4b5fd;">@Model.UpcomingCount</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-6 col-md-3">
                        <div class="kpi-card shadow-sm border-secondary">
                            <div class="kpi-title text-light">Toplam Sürpriz</div>
                            <div class="kpi-value text-white">@Model.TotalMatchesCount</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kpi-card shadow-sm border-warning border-opacity-50">
                            <div class="kpi-title text-warning">Dönüş (1/2 - 2/1)</div>
                            <div class="kpi-value text-warning">@Model.TurnaroundCount</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kpi-card shadow-sm border-info border-opacity-50">
                            <div class="kpi-title text-info">+6 Gol Biten</div>
                            <div class="kpi-value text-info">@Model.HighGoalCount</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kpi-card shadow-sm border-primary border-opacity-50">
                            <div class="kpi-title text-primary">Çifte Sürpriz</div>
                            <div class="kpi-value text-primary">@Model.DoubleSurpriseCount</div>
                        </div>
                    </div>
                }
            </div>

            <!-- HIZLI TÜR FİLTRELERİ & SIRALAMA -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="d-flex flex-wrap gap-2">
                    @if (fixturesMode)
                    {
                        <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="ALL"        asp-route-sort="@Model.SortOrder" asp-route-view="@view" class="btn-filter @(Model.SelectedFilter == "ALL"        ? "active" : "")">Tümü (@(Model.TotalMatchesCount + Model.UpcomingCount))</a>
                        <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="PENDING"    asp-route-sort="@Model.SortOrder" asp-route-view="@view" class="btn-filter @(Model.SelectedFilter == "PENDING"    ? "active" : "")">🔮 Kalan Fikstür (@Model.UpcomingCount)</a>
                        <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="SURPRISE"   asp-route-sort="@Model.SortOrder" asp-route-view="@view" class="btn-filter @(Model.SelectedFilter == "SURPRISE"   ? "active" : "")">✅ Sürpriz</a>
                        <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="TURNAROUND" asp-route-sort="@Model.SortOrder" asp-route-view="@view" class="btn-filter @(Model.SelectedFilter == "TURNAROUND" ? "active" : "")">🟠 Dönüş (@Model.TurnaroundCount)</a>
                        <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="HIGH_GOAL"  asp-route-sort="@Model.SortOrder" asp-route-view="@view" class="btn-filter @(Model.SelectedFilter == "HIGH_GOAL"  ? "active" : "")">🔵 +6 Gol (@Model.HighGoalCount)</a>
                        <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="NORMAL"     asp-route-sort="@Model.SortOrder" asp-route-view="@view" class="btn-filter @(Model.SelectedFilter == "NORMAL"     ? "active" : "")">Normal</a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="ALL"        asp-route-sort="@Model.SortOrder" asp-route-view="@view" class="btn-filter @(Model.SelectedFilter == "ALL"        ? "active" : "")">Tüm Sürprizler (@Model.TotalMatchesCount)</a>
                        <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="TURNAROUND" asp-route-sort="@Model.SortOrder" asp-route-view="@view" class="btn-filter @(Model.SelectedFilter == "TURNAROUND" ? "active" : "")">Dönüş (@Model.TurnaroundCount)</a>
                        <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="HIGH_GOAL"  asp-route-sort="@Model.SortOrder" asp-route-view="@view" class="btn-filter @(Model.SelectedFilter == "HIGH_GOAL"  ? "active" : "")">+6 Goller (@Model.HighGoalCount)</a>
                        <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="DOUBLE"     asp-route-sort="@Model.SortOrder" asp-route-view="@view" class="btn-filter @(Model.SelectedFilter == "DOUBLE"     ? "active" : "")">Çifte (@Model.DoubleSurpriseCount)</a>
                    }
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="@Model.SelectedFilter" asp-route-sort="@nextWeekSort" asp-route-view="@view" class="btn-filter @(Model.SortOrder.StartsWith("week") ? "active" : "")">
                        Hafta @(Model.SortOrder == "week_asc" ? "⬆️" : "⬇️")
                    </a>
                    <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="@Model.SelectedFilter" asp-route-sort="@nextDateSort" asp-route-view="@view" class="btn-filter @(Model.SortOrder.StartsWith("date") ? "active" : "")">
                        Tarih @(Model.SortOrder == "date_asc" ? "⬆️" : "⬇️")
                    </a>
                </div>
            </div>

            @if (Model.TeamStats != null)
            {
                var ts = Model.TeamStats;
                <div class="kpi-card shadow-sm border-secondary mb-3">
                    <div class="d-flex flex-wrap align-items-center gap-4">
                        <div>
                            <div class="kpi-title text-light">@ts.TeamName — Sezon Özeti</div>
                            <div class="fw-bold fs-5 text-white mt-1">@ts.Played O &nbsp;|&nbsp; @ts.Wins G - @ts.Draws B - @ts.Losses M</div>
                        </div>
                        @if (ts.LeagueRank.HasValue)
                        {
                            <div>
                                <div class="kpi-title text-light">Lig Sırası</div>
                                <div class="fw-bold fs-6 mt-1"><span style="color:#fbbf24">#@ts.LeagueRank</span> <span class="text-secondary">— @ts.LeaguePoints puan</span></div>
                                @if (!string.IsNullOrEmpty(ts.LeagueForm))
                                {
                                    <div class="mt-1" style="font-size:0.8rem; letter-spacing:2px;">
                                        @foreach (var c in ts.LeagueForm)
                                        {
                                            var color = c == 'W' ? "#4ade80" : c == 'D' ? "#94a3b8" : "#f87171";
                                            <span style="color:@color; font-weight:800;">@c</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <div>
                            <div class="kpi-title text-light">Gol (A - Y)</div>
                            <div class="fw-bold fs-6 mt-1"><span style="color:#38bdf8">@ts.GoalsFor</span> - <span style="color:#f87171">@ts.GoalsAgainst</span> <span class="text-secondary">(@(ts.GoalDiff > 0 ? "+" : "")@ts.GoalDiff)</span></div>
                        </div>
                        <div>
                            <div class="kpi-title text-light">Maç Başı Gol</div>
                            <div class="fw-bold fs-6 text-info mt-1">@ts.AvgTotalGoals.ToString("0.00")</div>
                        </div>
                        <div>
                            <div class="kpi-title text-light">Ev (G-B-M)</div>
                            <div class="fw-bold fs-6 text-white mt-1">@ts.HomeWins - @ts.HomeDraws - @ts.HomeLosses</div>
                        </div>
                        <div>
                            <div class="kpi-title text-light">Deplasman (G-B-M)</div>
                            <div class="fw-bold fs-6 text-white mt-1">@ts.AwayWins - @ts.AwayDraws - @ts.AwayLosses</div>
                        </div>
                        <div>
                            <div class="kpi-title text-light">+6 Gol / Dönüş / Sürpriz</div>
                            <div class="fw-bold fs-6 mt-1"><span style="color:#0284c7">@ts.HighGoalCount</span> / <span style="color:#ea580c">@ts.TurnaroundCount</span> / <span style="color:#a78bfa">@ts.SurpriseCount</span></div>
                        </div>
                    </div>
                </div>
            }

            <!-- MAÇ TABLOSU -->
            <div class="table-container shadow-sm">
                <div class="table-responsive">
                    <table class="table-dark-custom">
                        <thead>
                            <tr>
                                <th class="col-hafta">Hafta</th>
                                <th class="col-tarih">
                                    <!-- Tıklanabilir Tarih Sütunu Başlığı -->
                                    <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="@Model.SelectedFilter" asp-route-sort="@nextDateSort" asp-route-view="@view" class="sort-header" title="Tarihe göre sırala">
                                        Tarih @(Model.SortOrder == "date_desc" ? "▼" : "▲")
                                    </a>
                                </th>
                                <th class="col-mac">Karşılaşma</th>
                                <th class="col-iy">İY</th>
                                <th class="col-ms">MS</th>
                                <th class="col-sonuc">Sonuç</th>
                                <th class="col-gol">Toplam Gol</th>
                                <th class="col-durum">@(fixturesMode ? "Durum" : "Sürpriz Durumu")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Matches.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-secondary fw-semibold">
                                        @(fixturesMode
                                            ? "Seçili lig/sezon için maç kaydı bulunamadı."
                                            : "Seçili sezonda bu kritere uygun sürpriz maç kaydı bulunamadı.")
                                    </td>
                                </tr>
                            }
                            @foreach (var match in Model.Matches)
                            {
                                <tr class="@(!match.IsPlayed ? "row-upcoming" : "")">
                                    <td class="col-hafta fw-bold text-light">@match.Week. Hafta</td>
                                    <td class="col-tarih cell-date font-monospace">@match.MatchDate.ToString("dd.MM.yyyy")</td>
                                    <td class="col-mac fw-bold fs-6">
                                        @if (Model.SelectedTeamId.HasValue && match.IsHomeTeam)
                                        {
                                            <span style="color:#fb923c">@match.HomeTeam</span>
                                            <span class="text-secondary"> - @match.AwayTeam</span>
                                        }
                                        else if (Model.SelectedTeamId.HasValue && !match.IsHomeTeam)
                                        {
                                            <span class="text-secondary">@match.HomeTeam - </span>
                                            <span style="color:#60a5fa">@match.AwayTeam</span>
                                        }
                                        else
                                        {
                                            <span class="text-white">@match.HomeTeam - @match.AwayTeam</span>
                                        }
                                    </td>
                                    @if (!match.IsPlayed)
                                    {
                                        <td class="col-iy font-monospace text-secondary">—</td>
                                        <td class="col-ms font-monospace text-secondary">—</td>
                                        <td class="col-sonuc font-monospace text-secondary">—</td>
                                        <td class="col-gol font-monospace text-secondary">—</td>
                                        <td class="col-durum"><span class="badge-upcoming">🔜 Planlandı</span></td>
                                    }
                                    else
                                    {
                                        <td class="col-iy font-monospace cell-ht">@match.HtScore</td>
                                        <td class="col-ms font-monospace cell-ft">@match.FtScore</td>
                                        <td class="col-sonuc font-monospace cell-code">@match.IyMsCode</td>
                                        <td class="col-gol font-monospace cell-goals">@match.TotalGoals Gol</td>
                                        <td class="col-durum">
                                            @if (match.SurpriseType == "DOUBLE_SURPRISE")
                                            {
                                                <span class="badge-double">🟣 DOUBLE</span>
                                            }
                                            else if (match.SurpriseType == "TURNAROUND")
                                            {
                                                <span class="badge-turnaround">🟠 @match.IyMsCode DÖNÜŞ</span>
                                            }
                                            else if (match.SurpriseType == "HIGH_GOAL")
                                            {
                                                <span class="badge-highgoal">🔵 +6 GOL</span>
                                            }
                                            else if (fixturesMode)
                                            {
                                                <span class="text-secondary font-monospace">@match.MsResultCode</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            }
        </div>
    </div>
</div>

<script>
(function () {
    var input       = document.getElementById('teamSearchInput');
    var suggestions = document.getElementById('teamSuggestions');
    var select      = document.getElementById('teamSelect');
    if (!input || !select) return;

    // Tüm takımları option'lardan topla
    var options = Array.from(select.options).slice(1); // ilk "Tüm Takımlar" atla

    function buildSuggestions(query) {
        suggestions.innerHTML = '';
        if (!query) { suggestions.style.display = 'none'; return; }

        var filtered = options.filter(function(o) {
            return o.dataset.name && o.dataset.name.toLowerCase().includes(query.toLowerCase());
        });

        if (filtered.length === 0) { suggestions.style.display = 'none'; return; }

        // "Tüm Takımlar" seçeneği — kutu boşaldığında
        var clearDiv = document.createElement('div');
        clearDiv.textContent = '— Tüm Takımlar —';
        clearDiv.style.cssText = 'padding:8px 12px; cursor:pointer; color:#94a3b8; font-size:0.85rem; border-bottom:1px solid #334155;';
        clearDiv.onmousedown = function(e) {
            e.preventDefault();
            var clearOpt = select.options[0];
            if (clearOpt) location = clearOpt.value;
        };
        suggestions.appendChild(clearDiv);

        filtered.forEach(function(opt) {
            var div = document.createElement('div');
            div.textContent = opt.dataset.name;
            div.style.cssText = 'padding:8px 12px; cursor:pointer; color:#f8fafc; font-size:0.9rem; border-bottom:1px solid #1e293b;';
            div.onmouseover  = function() { this.style.background = '#2563eb'; };
            div.onmouseout   = function() { this.style.background = ''; };
            div.onmousedown  = function(e) {
                e.preventDefault();
                input.value = opt.dataset.name;
                suggestions.style.display = 'none';
                location = opt.value;
            };
            suggestions.appendChild(div);
        });

        suggestions.style.display = 'block';
    }

    input.addEventListener('input', function() { buildSuggestions(this.value.trim()); });
    input.addEventListener('focus', function() { buildSuggestions(this.value.trim()); });
    input.addEventListener('blur',  function() { setTimeout(function() { suggestions.style.display = 'none'; }, 150); });

    input.addEventListener('keydown', function(e) {
        var items = suggestions.querySelectorAll('div');
        var active = suggestions.querySelector('div.active-suggest');
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (!active && items.length) { items[0].classList.add('active-suggest'); items[0].style.background='#2563eb'; }
            else if (active) {
                var next = active.nextElementSibling;
                active.classList.remove('active-suggest'); active.style.background = '';
                if (next) { next.classList.add('active-suggest'); next.style.background='#2563eb'; }
            }
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (active) {
                var prev = active.previousElementSibling;
                active.classList.remove('active-suggest'); active.style.background = '';
                if (prev) { prev.classList.add('active-suggest'); prev.style.background='#2563eb'; }
            }
        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (active) { active.onmousedown({ preventDefault: function(){} }); }
        } else if (e.key === 'Escape') {
            suggestions.style.display = 'none';
        }
    });

    // Dışarı tıklanınca kapat
    document.addEventListener('click', function(e) {
        if (e.target !== input) suggestions.style.display = 'none';
    });
})();
</script>