@model DogisAnaliz.Models.DashboardViewModel
@{
    ViewData["Title"] = "DogisAnaliz - Dashboard";
    var nextWeekSort = Model.SortOrder == "week_asc" ? "week_desc" : "week_asc";
    var nextDateSort = Model.SortOrder == "date_desc" ? "date_asc"  : "date_desc";
}

<style>
    body {
        background-color: #0b1120;
        color: #f8fafc;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .sidebar {
        background-color: #1e293b;
        border-radius: 12px;
        min-height: 85vh;
        padding: 1.25rem;
        border: 1px solid #334155;
    }

    .nav-league-item {
        color: #cbd5e1;
        padding: 10px 14px;
        border-radius: 8px;
        text-decoration: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
        transition: all 0.2s;
        font-size: 0.95rem;
    }

        .nav-league-item:hover {
            background-color: #334155;
            color: #ffffff;
        }

        .nav-league-item.active {
            background-color: #2563eb;
            color: #ffffff;
            font-weight: bold;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.3);
        }

    .kpi-card {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 1.2rem;
    }

    .kpi-title {
        font-size: 0.85rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
    }

    .kpi-value {
        font-size: 1.9rem;
        font-weight: bold;
        margin-top: 4px;
    }

    .table-container {
        background-color: #1e293b;
        border-radius: 12px;
        padding: 1.25rem;
        border: 1px solid #334155;
    }

    .table-dark-custom {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 6px;
    }

        .table-dark-custom th {
            color: #cbd5e1;
            font-weight: 700;
            padding: 12px 14px;
            border-bottom: 2px solid #334155;
            text-align: left;
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .table-dark-custom td {
            background-color: #0f172a;
            padding: 14px;
            vertical-align: middle;
            border-top: 1px solid #1e293b;
            border-bottom: 1px solid #1e293b;
        }

        .table-dark-custom tr td:first-child {
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
            border-left: 1px solid #1e293b;
        }

        .table-dark-custom tr td:last-child {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
            border-right: 1px solid #1e293b;
        }

    /* Canlı ve Net Okunan Renkler */
    .cell-date {
        color: #f1f5f9 !important;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .cell-ht {
        color: #38bdf8 !important;
        font-weight: 700;
        font-size: 1rem;
    }

    .cell-ft {
        color: #ffffff !important;
        font-weight: 800;
        font-size: 1.05rem;
    }

    .cell-code {
        color: #fbbf24 !important;
        font-weight: 800;
        font-size: 1.05rem;
    }

    .cell-goals {
        color: #a78bfa !important;
        font-weight: 700;
        font-size: 1rem;
    }

    /* Rozetler */
    .badge-double {
        background-color: #7c3aed;
        color: #ffffff;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        display: inline-block;
    }

    .badge-turnaround {
        background-color: #ea580c;
        color: #ffffff;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        display: inline-block;
    }

    .badge-highgoal {
        background-color: #0284c7;
        color: #ffffff;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        display: inline-block;
    }

    /* Filtre Butonları */
    .btn-filter {
        background-color: #1e293b;
        border: 1px solid #334155;
        color: #cbd5e1;
        border-radius: 8px;
        padding: 7px 16px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-filter:hover {
            background-color: #334155;
            color: #ffffff;
        }

        .btn-filter.active {
            background-color: #2563eb;
            color: #ffffff;
            border-color: #2563eb;
        }

    .season-select {
        background-color: #0f172a;
        color: #f8fafc;
        border: 1px solid #475569;
        border-radius: 8px;
        padding: 6px 12px;
        font-weight: 600;
        font-size: 0.9rem;
    }

        .season-select:focus {
            border-color: #3b82f6;
            outline: none;
        }

    .sort-header {
        color: #f8fafc;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .sort-header:hover {
            color: #38bdf8;
        }

    /* Sütun genişlikleri - kayma önleme */
    .col-hafta   { width: 80px;  white-space: nowrap; }
    .col-tarih   { width: 110px; white-space: nowrap; }
    .col-mac     { min-width: 200px; }
    .col-iy      { width: 70px;  white-space: nowrap; text-align: center; }
    .col-ms      { width: 70px;  white-space: nowrap; text-align: center; }
    .col-sonuc   { width: 80px;  white-space: nowrap; text-align: center; }
    .col-gol     { width: 90px;  white-space: nowrap; text-align: center; }
    .col-durum   { width: 160px; white-space: nowrap; text-align: center; }
</style>

<div class="container-fluid mt-3 mb-5">
    <div class="row">
        <!-- SOL PANEL (SIDEBAR) -->
        <div class="col-md-3 col-lg-2 mb-3">
            <div class="sidebar shadow-sm">
                <h5 class="fw-bold mb-3 text-white d-flex align-items-center gap-2">
                    <span>🏆</span> Ligler
                </h5>
                <div class="nav flex-column">
                    @foreach (var league in Model.Leagues)
                    {
                        var isActive = league.Id == Model.SelectedLeagueId ? "active" : "";
                        <a asp-action="Index" asp-route-leagueId="@league.Id" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-sort="@Model.SortOrder" class="nav-league-item @isActive">
                            <span>@league.Name</span>
                            <span class="badge bg-dark border border-secondary rounded-pill">@league.SurpriseCount</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- SAĞ PANEL (ANA ÇALIŞMA ALANI) -->
        <div class="col-md-9 col-lg-10">
            <!-- ÜST BAŞLIK VE YIL / SEZON FİLTRESİ -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-dark p-3 rounded-3 border border-secondary border-opacity-25 shadow-sm">
                <div>
                    <h3 class="fw-bold text-white mb-0">@Model.SelectedLeagueName Sürpriz Analizi</h3>
                    <small class="text-secondary">Sadece 1/2, 2/1 ve +6 Gol Biten Özel Karşılaşmalar</small>
                </div>

                <!-- YIL / SEZON DROPDOWN FİLTRESİ -->
                <div class="d-flex align-items-center gap-2 mt-2 mt-sm-0 flex-wrap">
                    <label class="text-light fw-semibold small">Sezon:</label>
                    <select class="season-select" onchange="location = this.value;">
                        @foreach (var season in Model.Seasons)
                        {
                            var isSelected = season.Id == Model.SelectedSeasonId ? "selected" : "";
                            <!option value="@Url.Action("Index", new { leagueId = Model.SelectedLeagueId, seasonId = season.Id, teamId = Model.SelectedTeamId, filter = Model.SelectedFilter, sort = Model.SortOrder })" @isSelected>
                                @season.SeasonName
                            </!option>
                        }
                    </select>

                    @if (Model.Teams.Any())
                    {
                        <label class="text-light fw-semibold small ms-2">Takım:</label>
                        <div style="position:relative; display:inline-block;">
                            <!-- Yazarak arama kutusu -->
                            <input type="text" id="teamSearchInput" class="season-select"
                                   placeholder="Takım ara..." autocomplete="off"
                                   style="min-width:180px;"
                                   value="@(Model.SelectedTeamId.HasValue ? Model.Teams.FirstOrDefault(t => t.Id == Model.SelectedTeamId)?.Name : "")"
                                   oninput="filterTeamDropdown()" onkeydown="handleTeamKey(event)" />
                            <!-- Dropdown seçimi (normalde gizli, arama ile filtrelenir) -->
                            <select id="teamSelect" class="season-select" onchange="location = this.value;"
                                    style="min-width:180px; display:none;">
                                <option value="@Url.Action("Index", new { leagueId = Model.SelectedLeagueId, seasonId = Model.SelectedSeasonId, teamId = (int?)null, filter = Model.SelectedFilter, sort = Model.SortOrder })">
                                    — Tüm Takımlar —
                                </option>
                                @foreach (var team in Model.Teams)
                                {
                                    var isSel = team.Id == Model.SelectedTeamId;
                                    if (isSel)
                                    {
                                        <option value="@Url.Action("Index", new { leagueId = Model.SelectedLeagueId, seasonId = Model.SelectedSeasonId, teamId = team.Id, filter = Model.SelectedFilter, sort = Model.SortOrder })" selected
                                                data-name="@team.Name">
                                            @team.Name (@team.SurpriseCount)
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@Url.Action("Index", new { leagueId = Model.SelectedLeagueId, seasonId = Model.SelectedSeasonId, teamId = team.Id, filter = Model.SelectedFilter, sort = Model.SortOrder })"
                                                data-name="@team.Name">
                                            @team.Name (@team.SurpriseCount)
                                        </option>
                                    }
                                }
                            </select>
                            <!-- Öneri listesi -->
                            <div id="teamSuggestions" style="
                                display:none; position:absolute; top:100%; left:0; right:0;
                                background:#1e293b; border:1px solid #475569; border-radius:8px;
                                max-height:220px; overflow-y:auto; z-index:1000; min-width:220px;">
                            </div>
                        </div>
                        @if (Model.SelectedTeamId.HasValue)
                        {
                            <a href="@Url.Action("Index", new { leagueId = Model.SelectedLeagueId, seasonId = Model.SelectedSeasonId, filter = Model.SelectedFilter, sort = Model.SortOrder })"
                               class="btn-filter" style="padding:5px 10px; font-size:0.8rem;" title="Takım filtresini kaldır">✕</a>
                        }
                    }
                </div>
            </div>

            <!-- KPI ÖZET KARTLARI -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="kpi-card shadow-sm border-secondary">
                        <div class="kpi-title text-light">Toplam Sürpriz</div>
                        <div class="kpi-value text-white">@Model.TotalMatchesCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi-card shadow-sm border-warning border-opacity-50">
                        <div class="kpi-title text-warning">Dönüş (1/2 - 2/1)</div>
                        <div class="kpi-value text-warning">@Model.TurnaroundCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi-card shadow-sm border-info border-opacity-50">
                        <div class="kpi-title text-info">+6 Gol Biten</div>
                        <div class="kpi-value text-info">@Model.HighGoalCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi-card shadow-sm border-primary border-opacity-50">
                        <div class="kpi-title text-primary">Çifte Sürpriz</div>
                        <div class="kpi-value text-primary">@Model.DoubleSurpriseCount</div>
                    </div>
                </div>
            </div>

            <!-- HIZLI SÜRPRİZ TÜRÜ FİLTRELERİ & SIRALAMA -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="ALL"        asp-route-sort="@Model.SortOrder" class="btn-filter @(Model.SelectedFilter == "ALL"        ? "active" : "")">Tüm Sürprizler (@Model.TotalMatchesCount)</a>
                    <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="TURNAROUND" asp-route-sort="@Model.SortOrder" class="btn-filter @(Model.SelectedFilter == "TURNAROUND" ? "active" : "")">Dönüş (@Model.TurnaroundCount)</a>
                    <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="HIGH_GOAL"  asp-route-sort="@Model.SortOrder" class="btn-filter @(Model.SelectedFilter == "HIGH_GOAL"  ? "active" : "")">+6 Goller (@Model.HighGoalCount)</a>
                    <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="DOUBLE"     asp-route-sort="@Model.SortOrder" class="btn-filter @(Model.SelectedFilter == "DOUBLE"     ? "active" : "")">Çifte (@Model.DoubleSurpriseCount)</a>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="@Model.SelectedFilter" asp-route-sort="@nextWeekSort" class="btn-filter @(Model.SortOrder.StartsWith("week") ? "active" : "")">
                        Hafta @(Model.SortOrder == "week_asc" ? "⬆️" : "⬇️")
                    </a>
                    <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-teamId="@Model.SelectedTeamId" asp-route-filter="@Model.SelectedFilter" asp-route-sort="@nextDateSort" class="btn-filter @(Model.SortOrder.StartsWith("date") ? "active" : "")">
                        Tarih @(Model.SortOrder == "date_asc" ? "⬆️" : "⬇️")
                    </a>
                </div>
            </div>

            <!-- MAÇ TABLOSU -->
            <div class="table-container shadow-sm">
                <div class="table-responsive">
                    <table class="table-dark-custom">
                        <thead>
                            <tr>
                                <th class="col-hafta">Hafta</th>
                                <th class="col-tarih">
                                    <!-- Tıklanabilir Tarih Sütunu Başlığı -->
                                    <a asp-action="Index" asp-route-leagueId="@Model.SelectedLeagueId" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-filter="@Model.SelectedFilter" asp-route-sort="@nextDateSort" class="sort-header" title="Tarihe göre sırala">
                                        Tarih @(Model.SortOrder == "date_desc" ? "▼" : "▲")
                                    </a>
                                </th>
                                <th class="col-mac">Karşılaşma</th>
                                <th class="col-iy">İY</th>
                                <th class="col-ms">MS</th>
                                <th class="col-sonuc">Sonuç</th>
                                <th class="col-gol">Toplam Gol</th>
                                <th class="col-durum">Sürpriz Durumu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Matches.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-secondary fw-semibold">
                                        Seçili sezonda bu kritere uygun sürpriz maç kaydı bulunamadı.
                                    </td>
                                </tr>
                            }
                            @foreach (var match in Model.Matches)
                            {
                                <tr>
                                    <td class="col-hafta fw-bold text-light">@match.Week. Hafta</td>
                                    <td class="col-tarih cell-date font-monospace">@match.MatchDate.ToString("dd.MM.yyyy")</td>
                                    <td class="col-mac fw-bold fs-6">
                                        @if (Model.SelectedTeamId.HasValue && match.IsHomeTeam)
                                        {
                                            <span style="color:#fb923c">@match.HomeTeam</span>
                                            <span class="text-secondary"> - @match.AwayTeam</span>
                                        }
                                        else if (Model.SelectedTeamId.HasValue && !match.IsHomeTeam)
                                        {
                                            <span class="text-secondary">@match.HomeTeam - </span>
                                            <span style="color:#60a5fa">@match.AwayTeam</span>
                                        }
                                        else
                                        {
                                            <span class="text-white">@match.HomeTeam - @match.AwayTeam</span>
                                        }
                                    </td>
                                    <td class="col-iy font-monospace cell-ht">@match.HtScore</td>
                                    <td class="col-ms font-monospace cell-ft">@match.FtScore</td>
                                    <td class="col-sonuc font-monospace cell-code">@match.IyMsCode</td>
                                    <td class="col-gol font-monospace cell-goals">@match.TotalGoals Gol</td>
                                    <td class="col-durum">
                                        @if (match.SurpriseType == "DOUBLE_SURPRISE")
                                        {
                                            <span class="badge-double">🟣 DOUBLE</span>
                                        }
                                        else if (match.SurpriseType == "TURNAROUND")
                                        {
                                            <span class="badge-turnaround">🟠 @match.IyMsCode DÖNÜŞ</span>
                                        }
                                        else if (match.SurpriseType == "HIGH_GOAL")
                                        {
                                            <span class="badge-highgoal">🔵 +6 GOL</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var input       = document.getElementById('teamSearchInput');
    var suggestions = document.getElementById('teamSuggestions');
    var select      = document.getElementById('teamSelect');
    if (!input || !select) return;

    // Tüm takımları option'lardan topla
    var options = Array.from(select.options).slice(1); // ilk "Tüm Takımlar" atla

    function buildSuggestions(query) {
        suggestions.innerHTML = '';
        if (!query) { suggestions.style.display = 'none'; return; }

        var filtered = options.filter(function(o) {
            return o.dataset.name && o.dataset.name.toLowerCase().includes(query.toLowerCase());
        });

        if (filtered.length === 0) { suggestions.style.display = 'none'; return; }

        // "Tüm Takımlar" seçeneği — kutu boşaldığında
        var clearDiv = document.createElement('div');
        clearDiv.textContent = '— Tüm Takımlar —';
        clearDiv.style.cssText = 'padding:8px 12px; cursor:pointer; color:#94a3b8; font-size:0.85rem; border-bottom:1px solid #334155;';
        clearDiv.onmousedown = function(e) {
            e.preventDefault();
            var clearOpt = select.options[0];
            if (clearOpt) location = clearOpt.value;
        };
        suggestions.appendChild(clearDiv);

        filtered.forEach(function(opt) {
            var div = document.createElement('div');
            div.textContent = opt.dataset.name;
            div.style.cssText = 'padding:8px 12px; cursor:pointer; color:#f8fafc; font-size:0.9rem; border-bottom:1px solid #1e293b;';
            div.onmouseover  = function() { this.style.background = '#2563eb'; };
            div.onmouseout   = function() { this.style.background = ''; };
            div.onmousedown  = function(e) {
                e.preventDefault();
                input.value = opt.dataset.name;
                suggestions.style.display = 'none';
                location = opt.value;
            };
            suggestions.appendChild(div);
        });

        suggestions.style.display = 'block';
    }

    input.addEventListener('input', function() { buildSuggestions(this.value.trim()); });
    input.addEventListener('focus', function() { buildSuggestions(this.value.trim()); });
    input.addEventListener('blur',  function() { setTimeout(function() { suggestions.style.display = 'none'; }, 150); });

    input.addEventListener('keydown', function(e) {
        var items = suggestions.querySelectorAll('div');
        var active = suggestions.querySelector('div.active-suggest');
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (!active && items.length) { items[0].classList.add('active-suggest'); items[0].style.background='#2563eb'; }
            else if (active) {
                var next = active.nextElementSibling;
                active.classList.remove('active-suggest'); active.style.background = '';
                if (next) { next.classList.add('active-suggest'); next.style.background='#2563eb'; }
            }
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (active) {
                var prev = active.previousElementSibling;
                active.classList.remove('active-suggest'); active.style.background = '';
                if (prev) { prev.classList.add('active-suggest'); prev.style.background='#2563eb'; }
            }
        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (active) { active.onmousedown({ preventDefault: function(){} }); }
        } else if (e.key === 'Escape') {
            suggestions.style.display = 'none';
        }
    });

    // Dışarı tıklanınca kapat
    document.addEventListener('click', function(e) {
        if (e.target !== input) suggestions.style.display = 'none';
    });
})();
</script>