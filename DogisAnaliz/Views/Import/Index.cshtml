@{
    ViewData["Title"] = "Excel Veri Aktarımı";
}

<style>
    .import-header { background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 100%); color: white; border-radius: 12px; padding: 24px 28px; margin-bottom: 24px; }
    .import-title  { font-size: 1.8rem; font-weight: 700; margin: 0; }
    .import-sub    { font-size: 0.88rem; opacity: 0.8; margin-top: 4px; }
    .card-form     { border-radius: 12px; border: 1px solid #dee2e6; padding: 28px; background: #fff; }
    .preset-btn    { font-size: 0.8rem; border-radius: 6px; }
</style>

<div class="import-header">
    <div class="import-title">📥 Excel Veri Aktarımı</div>
    <div class="import-sub">2025-2026 sezon verilerini Excel dosyasından veritabanına aktarın</div>
</div>

@* Başarı mesajı *@
@if (ViewBag.Success != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ @ViewBag.Success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Hata mesajı *@
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ❌ @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Çakışma uyarısı — üzerine yazma onayı *@
@if (ViewBag.Warning != null)
{
    <div class="alert alert-warning" role="alert">
        <h5 class="alert-heading">⚠️ Veri Zaten Mevcut!</h5>
        <p>@ViewBag.Warning</p>
        <p class="mb-0">Bu verilerin <strong>üzerine yazılsın mı?</strong> (Mevcut maçlar silinecek)</p>
        <hr/>
        <form method="post" action="/Import/ForceUpload">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger btn-sm">🗑️ Evet, üzerine yaz</button>
            <a href="/Import" class="btn btn-secondary btn-sm ms-2">İptal</a>
        </form>
    </div>
}

<div class="card-form mb-4">
    <form method="post" action="/Import/Upload" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <!-- Dosya Seçimi -->
            <div class="col-12">
                <label class="form-label fw-bold">📄 Excel Dosyası (.xlsx / .xls)</label>
                <input type="file" name="excelFile" class="form-control" accept=".xlsx,.xls" required />
                <div class="form-text">Sütunlar: SIRA NO, HAFTA, TARİH, MAÇ, İY, MS, SONUÇ</div>
            </div>

            <!-- Lig Bilgileri -->
            <div class="col-md-6">
                <label class="form-label fw-bold">🏆 Lig Adı</label>
                <input type="text" name="leagueName" id="leagueName" class="form-control" placeholder="örn: Bundesliga" required />
                <div class="mt-2">
                    <small class="text-muted">Hızlı seçim: </small><br/>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        <button type="button" class="btn btn-outline-secondary btn-sm preset-btn" onclick="setLeague('Bundesliga','Germany')">🇩🇪 Bundesliga</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm preset-btn" onclick="setLeague('Premier League','England')">🏴󠁧󠁢󠁥󠁮󠁧󠁿 Premier League</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm preset-btn" onclick="setLeague('Serie A','Italy')">🇮🇹 Serie A</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm preset-btn" onclick="setLeague('Ligue 1','France')">🇫🇷 Ligue 1</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm preset-btn" onclick="setLeague('Süper Lig','Turkey')">🇹🇷 Süper Lig</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm preset-btn" onclick="setLeague('La Liga','Spain')">🇪🇸 La Liga</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm preset-btn" onclick="setLeague('Eredivisie','Netherlands')">🇳🇱 Eredivisie</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm preset-btn" onclick="setLeague('Primeira Liga','Portugal')">🇵🇹 Primeira Liga</button>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">🌍 Ülke</label>
                <input type="text" name="country" id="country" class="form-control" placeholder="örn: Germany" />
                <div class="form-text">Lig veritabanında zaten varsa bu alan kullanılmaz.</div>
            </div>

            <!-- Sezon Bilgileri -->
            <div class="col-md-4">
                <label class="form-label fw-bold">📅 Sezon Adı</label>
                <input type="text" name="seasonName" class="form-control" value="2025-2026" required />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Başlangıç Yılı</label>
                <input type="number" name="startYear" class="form-control" value="2025" required />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Bitiş Yılı</label>
                <input type="number" name="endYear" class="form-control" value="2026" required />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-success px-4">
                    📥 Veritabanına Aktar
                </button>
            </div>
        </div>
    </form>
</div>

@* Mevcut veriler tablosu *@
@if (ViewBag.Leagues != null)
{
    var leagues = (IEnumerable<DogisAnaliz.Models.League>)ViewBag.Leagues;
    if (leagues.Any())
    {
        <div class="mt-2">
            <h6 class="fw-bold text-muted">Veritabanındaki Mevcut Ligler</h6>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var l in leagues)
                {
                    <span class="badge bg-secondary">@l.Name</span>
                }
            </div>
        </div>
    }
}

<script>
    function setLeague(name, country) {
        document.getElementById('leagueName').value = name;
        document.getElementById('country').value = country;
    }
</script>
